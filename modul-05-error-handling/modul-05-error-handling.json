      "name": "Header – Node Settings"
    },
    {
      "parameters": {
        "content": "**On Error: Stop Workflow**\n\n- Standard-Aktion\n- Workflow stoppt komplett bei einem Fehler\n- Rotes X am Node\n- Nichts danach wird ausgeführt\n- Fehler: string vs. number",
        "height": 220,
        "width": 320,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
