    {
      "parameters": {
        "jsCode": "// BEREITS FERTIG – nicht verändern\nconst leads = $input.first().json.processed_leads;\nif (!Array.isArray(leads)) {\n  throw new Error(\"Feld 'processed_leads' fehlt. Aufgabe 5 (Aggregate): Das Destination Field muss exakt 'processed_leads' heißen (alles klein, mit Unterstrich).\");\n}\n\nconst hinweise = [];\nconst teilnehmer = String($('AUFGABE 0 – Namen eintragen').first().json.name || '').trim();\nif (!teilnehmer) hinweise.push('AUFGABE 0: Euer Name fehlt. Tragt ihn im ersten Node ein, sonst landet nichts im Scoreboard.');\nif (leads.length !== 5) hinweise.push(`Es kommen ${leads.length} statt 5 Leads an. Aufgabe 1 (Split) und Aufgabe 4 (Merge, Modus Append) prüfen.`);\nif (leads.some(l => l.name === undefined)) hinweise.push(\"Die ursprünglichen Felder (name, score, region) fehlen. Im Set-Node 'Include Other Input Fields' einschalten.\");\nfor (const feld of ['Type', 'Priority']) {\n  if (leads.some(l => l[feld] === undefined)) {\n    const aehnlich = Object.keys(leads[0] || {}).find(k => k.toLowerCase() === feld.toLowerCase());\n    hinweise.push(aehnlich\n      ? `Feld '${feld}' fehlt, es gibt aber '${aehnlich}'. Groß-/Kleinschreibung zählt!`\n      : `Feld '${feld}' fehlt. Aufgabe 3a und 3b prüfen.`);\n  }\n}\n\nconst qualified = leads.filter(l => l.Type === 'Qualifiziert');\nconst rejected  = leads.filter(l => l.Type === 'Abgelehnt');\nif (hinweise.length === 0 && (qualified.length !== 3 || rejected.length !== 2)) {\n  hinweise.push(`Erwartet: 3 x 'Qualifiziert' und 2 x 'Abgelehnt'. Gefunden: ${qualified.length} und ${rejected.length}. Schwelle in Aufgabe 2 (Score >= 60) und Schreibweise der Werte prüfen.`);\n}\n\nreturn [{\n  json: {\n    timestamp:        new Date().toLocaleString('de-DE', { timeZone: 'Europe/Berlin' }),\n    korrekt:          hinweise.length === 0 ? '✅ Ja' : '❌ Nein',\n    hinweise:         hinweise.length ? hinweise.join(' | ') : 'Alles richtig!',\n    qualified_count:  qualified.length,\n    rejected_count:   rejected.length,\n    qualified_names:  qualified.map(l => l.name).join(', '),\n    rejected_names:   rejected.map(l => l.name).join(', '),\n    high_priority:    qualified.filter(l => l.Priority === 'Hoch').map(l => l.name).join(', '),\n    low_priority:     rejected.filter(l => l.Priority === 'Niedrig').map(l => l.name).join(', ')\n  }\n}];"
      },
