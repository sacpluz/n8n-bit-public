    {
      "parameters": {
        "jsCode": "// BEREITS FERTIG – nicht verändern\nconst r = $input.first().json;\nconst pflicht = ['cheapest_offer_supplier', 'cheapest_offer_price_EUR', 'timestamp'];\nconst fehlt = pflicht.filter(k => r[k] === undefined || r[k] === null || r[k] === '');\nif (fehlt.length) {\n  const tipp = fehlt.map(k => {\n    const aehnlich = Object.keys(r).find(x => x.toLowerCase() === k.toLowerCase());\n    return aehnlich ? `'${k}' (vorhanden ist '${aehnlich}', Groß-/Kleinschreibung zählt!)` : `'${k}'`;\n  }).join(', ');\n  throw new Error(`Diese Felder fehlen oder sind leer: ${tipp}. Aufgabe 5 (Edit Fields) prüfen. Sind sie dort leer, liefert Aufgabe 4 kein 'cheapestOffer'.`);\n}\nconst hinweise = [];\nif (typeof r.cheapest_offer_price_EUR !== 'number') hinweise.push(\"'cheapest_offer_price_EUR' ist kein Number. Im Edit-Fields-Node den Typ auf Number stellen.\");\nif (!(Number(r.cheapest_offer_price_EUR) > 0)) hinweise.push(\"Der Preis ist 0. Liefert der HTTP Request 'rates.EUR'? Stimmt der Node-Name in $('Loop Over Items')?\");\nreturn [{ json: { ...r, hinweise: hinweise.length ? hinweise.join(' | ') : 'Alles richtig!' } }];"
      },
