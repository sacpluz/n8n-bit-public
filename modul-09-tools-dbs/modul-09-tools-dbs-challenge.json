    {
      "parameters": {
        "jsCode": "// BEREITS FERTIG – nicht verändern\n// Prüft beide Testfragen: Überwachung (semantisch, erwartet ID 11) und David Fincher (strukturiert)\nconst hinweise = [];\nconst teilnehmer = String($('AUFGABE 0 – Namen eintragen').first().json.name || '').trim();\nif (!teilnehmer) hinweise.push('AUFGABE 0: Euer Name fehlt. Tragt ihn im ersten Node ein, sonst landet nichts im Scoreboard.');\n\nconst lief = (name) => { try { return $(name).isExecuted; } catch (e) { return false; } };\nconst lies = (o) => { if (typeof o === 'string') { try { return JSON.parse(o); } catch (e) { return o; } } return o; };\n\n// 1) RAG Search Agent: strukturierte Ausgabe?\nconst rag = $('AUFGABE 1 – RAG Search Agent').all().map(i => lies(i.json.output));\nif (rag.some(o => Array.isArray(o))) {\n  hinweise.push('AUFGABE 2: Das JSON-Beispiel im Output Parser ist ein Array ([ … ]). Nehmt das Beispiel aus dem Handout, es beginnt mit {.');\n} else if (rag.some(o => !o || typeof o !== 'object')) {\n  hinweise.push('AUFGABE 2: Der RAG Search Agent liefert Text statt JSON. Require Specific Output Format einschalten und den Structured Output Parser anschließen.');\n} else if (rag.some(o => typeof o.semantic_search_performed !== 'boolean')) {\n  hinweise.push(\"AUFGABE 2: Im Output fehlt das Feld 'semantic_search_performed' (true/false). JSON-Beispiel aus dem Handout prüfen, Schreibweise zählt.\");\n} else {\n  const [ueberwachung, fincher] = rag;\n  if (ueberwachung.semantic_search_performed !== true) {\n    hinweise.push('AUFGABE 1: Die Frage nach Überwachung ist eine Themenfrage, der RAG-Agent hat aber nicht semantisch gesucht. Ist die System Message vollständig eingefügt?');\n  } else {\n    const ids = (ueberwachung.results || []).map(r => String(r.ID));\n    if (!ids.length) hinweise.push('AUFGABE 3: Die Vektorsuche liefert keine Treffer. Ist das Qdrant-Tool angeschlossen und die Collection \"n8n workshop\" gewählt?');\n    else if (!ids.includes('11')) hinweise.push(`AUFGABE 3/4: \"Das Leben der Anderen\" (ID 11) fehlt in den Treffern (gefunden: ${ids.join(', ')}). Embedding-Modell text-embedding-3-small? Include Metadata an?`);\n  }\n  if (fincher && fincher.semantic_search_performed !== false) {\n    hinweise.push('AUFGABE 1: Die Frage nach David Fincher ist eine Faktenfrage, der RAG-Agent hat trotzdem semantisch gesucht. System Message prüfen.');\n  }\n}\n\n// 2) IF: beide Wege benutzt?\nif (!lief('Prompt – IDs nachschlagen')) hinweise.push('AUFGABE 5: Keine Frage kam am true-Ausgang an. Bedingung: {{ $json.output.semantic_search_performed }} – Boolean – is true.');\nif (!lief('Prompt – Frage weitergeben')) hinweise.push('AUFGABE 5: Keine Frage kam am false-Ausgang an. Steht die Bedingung auf \"is true\" (nicht \"exists\")?');\n\n// 3) Antworten des Structured Search Agent\nconst antworten = $input.all().map(i => String(i.json.output || ''));\nconst alles = antworten.join('\\n').toLowerCase();\nif (!alles.includes('leben der anderen')) hinweise.push('AUFGABE 6/7: In den Antworten fehlt \"Das Leben der Anderen\". Prompt im Structured Search Agent = {{ $json.prompt }}? Liefert das Airtable-Tool Daten?');\nif (!/se7en|seven/.test(alles) || !alles.includes('zodiac')) hinweise.push('AUFGABE 6/7: Für David Fincher fehlen \"Se7en\" oder \"Zodiac\". Ist das Airtable-Tool angeschlossen, Base und Table per ID eingetragen, Filter By Formula vom Modell?');\n\nreturn [{ json: {\n  antworten,\n  korrekt: hinweise.length === 0 ? '✅ Ja' : '❌ Nein',\n  hinweise: hinweise.length ? hinweise.join(' | ') : 'Alles richtig!'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        940
      ],
      "id": "5482575d-0a05-4fcb-afc7-e027ae46b36f",
      "name": "Ergebnis prüfen"
    },
